soong_namespace {
    imports: ["hardware/qcom-caf/bootctrl"],
}

prebuilt_etc {
    name: "nabu-debug-init",
    src: "rootdir/etc/init.nabu.debug.rc",
    filename: "init.nabu.debug.rc",
    sub_dir: "init",
}

android_library {
    name: "nabu_tablet_settings_config",
    static_libs: ["//device/xiaomi/sm8150-common/tablet:sm8150_tablet_settings_defaults"],
    resource_dirs: ["configs/tablet-settings/res"],
    manifest: "configs/tablet-settings/AndroidManifest.xml",
    platform_apis: true,
}
