# Installed only in userdebug/eng. Prepare USB before /data and Android services.
# The updatable adbd service is queued until its APEX has been activated.
on init && property:ro.debuggable=1
    # Platform init has already mounted configfs during its on-init action.
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno:-nabu-debug}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    setprop sys.usb.controller ${ro.boot.usbcontroller:-a600000.dwc3}
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb
    start adbd

# An existing /data property must not restore a non-ADB configuration.
on property:ro.persistent_properties.ready=true && property:ro.debuggable=1
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb

# Qualcomm's boot USB script resets sys.usb.config; restore the debug mode after it.
on boot && property:ro.debuggable=1
    setprop persist.sys.usb.config adb
    setprop sys.usb.config adb
