allow devicesettings_app {
  activity_service
  activity_task_service
  app_api_service
  audio_service
  audioserver_service
  autofill_service
  cameraserver_service
  drmserver_service
  media_session_service
  mediaextractor_service
  mediametrics_service
  mediaserver_service
  surfaceflinger_service
}:service_manager find;

binder_call(devicesettings_app, hal_custom_hwcontrol)

allow devicesettings_app sysfs_leds:dir r_dir_perms;
